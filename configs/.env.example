# Mini-SOC Configuration

# ==================== Network ====================
NETWORK_INTERFACE=eth0
LAN_SUBNET=192.168.1.0/24

# ==================== Telegram ====================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=123456789

# ==================== Email ====================
EMAIL_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL=your-email@gmail.com

# ==================== Detection Thresholds ====================
ANOMALY_THRESHOLD=0.3
NEW_DEVICE_ALERT=true
RARE_DOMAIN_THRESHOLD=100000

# ==================== Zeek ====================
ZEEK_LOG_DIR=/opt/zeek/logs
ZEEK_SCRIPTS_DIR=/opt/zeek/share/zeek/site

# ==================== Database ====================
POSTGRES_USER=minisoc
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=minisoc_db

# ==================== Grafana ====================
GRAFANA_ADMIN_PASSWORD=change_this_admin_password

# ==================== Service Intervals ====================
ANALYZER_INTERVAL=300        # Seconds (5 minutes)
SCANNER_INTERVAL=600         # Seconds (10 minutes)

# ==================== Model Training ====================
CONTAMINATION=0.05
N_ESTIMATORS=100
TRAINING_DAYS=7
